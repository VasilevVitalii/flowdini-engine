{
  "name": "flowdini-engine",
  "version": "0.2.5",
  "description": "Deterministic execution engine for flowdini: journal orchestration (arcs, gating, roles) plus content validation and formatting",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "flowdini",
    "markdown",
    "obsidian",
    "engine",
    "validation"
  ],
  "license": "MIT",
  "author": "Vitalii Vasilev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VasilevVitalii/flowdini-engine.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "flowdini-spec": "^0.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
